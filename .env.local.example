# ══════════════════════════════════════════════════════════
#  Is file ko copy karke ".env.local" naam se save karo
#  aur apni asli values daalo.
#
#  .env.local ko GIT MEIN KABHI COMMIT MAT KARNA.
#  (.gitignore mein pehle se hai)
# ══════════════════════════════════════════════════════════

# Supabase Dashboard > Project Settings > Data API se milega
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase Dashboard > Project Settings > API Keys > anon / publishable
# Ye key browser mein jaati hai — ye NORMAL hai. Isko RLS protect karta hai.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Tumhara live domain. Email confirmation link isi pe aayega.
# Local pe: http://localhost:3000
# Server pe: https://ecoweave.in
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ⚠️  service_role key kabhi bhi NEXT_PUBLIC_ ke saath mat likhna.
#     Wo RLS bypass kar deti hai — leak hui to poora database khul jayega.
